{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /login 200",
  "type": "object",
  "required": ["message", "authorization"],
  "additionalProperties": false,
  "properties": {
    "message": {"type": "string"},
    "authorization": {"type": "string", "pattern": "^Bearer [\\w-]+\\.[\\w-]+\\.[\\w-]+$"}
  }
}
